{
  "manifest_version": 3,
  "minimum_chrome_version": "133",
  "name": "AirNox",
  "short_name": "AirNox",
  "version": "0.1.0",
  "description": "Connects web3 sites to the AirNox Wallet desktop app, which keeps your keys and asks you to approve every request.",
  "author": "AirNox",
  "homepage_url": "https://airnox.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["ws://127.0.0.1/*"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/inpage/inpage.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; connect-src ws://127.0.0.1:*"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "AirNox",
    "default_popup": "src/popup/popup.html"
  }
}
